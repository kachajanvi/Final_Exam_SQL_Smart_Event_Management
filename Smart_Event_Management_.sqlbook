-- SQLBook: Code
SELECT *
FROM Events
WHERE event_name LIKE '%AI%';
-- SQLBook: Code
SELECT
    e.event_id,
    e.event_name,
    e.event_date,
    v.location
FROM Events e
JOIN Venues v
ON e.venue_id = v.venue_id
WHERE v.location = 'Surat'
AND e.event_date > CURRENT_DATE;
-- SQLBook: Code
SELECT
    e.event_id,
    e.event_name,
    COALESCE(SUM(
        CASE
            WHEN p.payment_status = 'Success'
            THEN p.amount_paid
            ELSE 0
        END
    ), 0) AS total_revenue
FROM Events e
LEFT JOIN Tickets t
ON e.event_id = t.event_id
LEFT JOIN Payments p
ON t.ticket_id = p.ticket_id
GROUP BY e.event_id, e.event_name
ORDER BY total_revenue DESC
LIMIT 5;
-- SQLBook: Code
SELECT
    e.event_name,
    COUNT(t.ticket_id) AS confirmed_tickets
FROM Events e
JOIN Tickets t
ON e.event_id = t.event_id
WHERE t.status = 'Confirmed'
GROUP BY e.event_id, e.event_name
HAVING COUNT(t.ticket_id) > 1;
-- SQLBook: Code
SELECT *
FROM Events
WHERE MONTH(event_date) = 12
AND available_seats > total_seats * 0.50;
-- SQLBook: Code
SELECT DISTINCT
    a.attendee_id,
    a.name
FROM Attendees a
JOIN Tickets t
ON a.attendee_id = t.attendee_id
LEFT JOIN Payments p
ON t.ticket_id = p.ticket_id
WHERE t.status = 'Confirmed'
OR p.payment_status = 'Pending';
-- SQLBook: Code
SELECT DISTINCT
    a.attendee_id,
    a.name
FROM Attendees a
JOIN Tickets t
ON a.attendee_id = t.attendee_id
WHERE NOT t.status = 'Confirmed';
-- SQLBook: Code
SELECT * FROM Events
ORDER BY event_date ASC;
-- SQLBook: Code
SELECT
    e.event_name,
    COUNT(t.attendee_id) AS total_attendees
FROM Events e
LEFT JOIN Tickets t
ON e.event_id = t.event_id
GROUP BY e.event_id, e.event_name;
-- SQLBook: Code
SELECT
    e.event_name,
    COALESCE(SUM(
        CASE
            WHEN p.payment_status = 'Success'
            THEN p.amount_paid
            ELSE 0
        END
    ), 0) AS total_revenue
FROM Events e
LEFT JOIN Tickets t
ON e.event_id = t.event_id
LEFT JOIN Payments p
ON t.ticket_id = p.ticket_id
GROUP BY e.event_id, e.event_name;
-- SQLBook: Code
SELECT
    SUM(amount_paid) AS total_revenue
FROM Payments
WHERE payment_status = 'Success';
-- SQLBook: Code
SELECT
    e.event_name,
    COUNT(t.ticket_id) AS total_attendees
FROM Events e
JOIN Tickets t
ON e.event_id = t.event_id
WHERE t.status = 'Confirmed'
GROUP BY e.event_id, e.event_name
ORDER BY total_attendees DESC
LIMIT 1;

-- SQLBook: Code
SELECT
    AVG(ticket_price) AS average_ticket_price
FROM Events;
-- SQLBook: Code
SELECT
    MAX(ticket_price) AS maximum_ticket_price
FROM Events;
-- SQLBook: Code
SELECT
    MIN(ticket_price) AS minimum_ticket_price
FROM Events;

-- SQLBook: Code
SELECT
    COUNT(*) AS total_attendees
FROM Attendees;
-- SQLBook: Code
SELECT
    TABLE_NAME,
    CONSTRAINT_NAME,
    COLUMN_NAME,
    REFERENCED_TABLE_NAME,
    REFERENCED_COLUMN_NAME
FROM information_schema.KEY_COLUMN_USAGE
WHERE TABLE_SCHEMA = 'smart_event_management'
AND REFERENCED_TABLE_NAME IS NOT NULL;
-- SQLBook: Code
SELECT
    e.event_name,
    v.venue_name,
    v.location
FROM Events e
INNER JOIN Venues v
ON e.venue_id = v.venue_id;
-- SQLBook: Code
SELECT
    a.name,
    t.ticket_id,
    p.payment_status
FROM Attendees a
LEFT JOIN Tickets t
ON a.attendee_id = t.attendee_id
LEFT JOIN Payments p
ON t.ticket_id = p.ticket_id
WHERE p.payment_status IS NULL
OR p.payment_status <> 'Success';
-- SQLBook: Code
SELECT
    e.event_name,
    t.ticket_id
FROM Tickets t
RIGHT JOIN Events e
ON t.event_id = e.event_id;

-- SQLBook: Code
SELECT
    e.event_name,
    t.ticket_id
FROM Events e
LEFT JOIN Tickets t
ON e.event_id = t.event_id

UNION

SELECT
    e.event_name,
    t.ticket_id
FROM Events e
RIGHT JOIN Tickets t
ON e.event_id = t.event_id;
-- SQLBook: Code
SELECT
    e.event_id,
    e.event_name
FROM Events e
JOIN Tickets t
ON e.event_id = t.event_id
JOIN Payments p
ON t.ticket_id = p.ticket_id
WHERE p.payment_status = 'Success'
GROUP BY e.event_id, e.event_name
HAVING SUM(p.amount_paid) >
(
    SELECT AVG(event_revenue)
    FROM
    (
        SELECT
            SUM(p2.amount_paid) AS event_revenue
        FROM Tickets t2
        JOIN Payments p2
        ON t2.ticket_id = p2.ticket_id
        WHERE p2.payment_status = 'Success'
        GROUP BY t2.event_id
    ) AS revenue_table
);

-- SQLBook: Code
SELECT
    a.attendee_id,
    a.name
FROM Attendees a
JOIN Tickets t
ON a.attendee_id = t.attendee_id
GROUP BY a.attendee_id, a.name
HAVING COUNT(DISTINCT t.event_id) > 1;
-- SQLBook: Code
SELECT
    o.organizer_id,
    o.organizer_name,
    COUNT(e.event_id) AS total_events
FROM Organizers o
JOIN Events e
ON o.organizer_id = e.organizer_id
GROUP BY o.organizer_id, o.organizer_name
HAVING COUNT(e.event_id) > 3;
-- SQLBook: Code
SELECT
    event_name,
    event_date,
    MONTH(event_date) AS event_month
FROM Events;

-- SQLBook: Code
SELECT
    event_name,
    event_date,
    DATEDIFF(event_date, CURRENT_DATE) AS days_remaining
FROM Events
WHERE event_date >= CURRENT_DATE;
-- SQLBook: Code
SELECT
    payment_id,
    DATE_FORMAT(
        payment_date,
        '%Y-%m-%d %H:%i:%s'
    ) AS formatted_payment_date
FROM Payments;

-- SQLBook: Code
SELECT
    organizer_id,
    UPPER(organizer_name) AS organizer_name
FROM Organizers;
-- SQLBook: Code
SELECT
    attendee_id,
    TRIM(name) AS cleaned_name
FROM Attendees;
-- SQLBook: Code
SELECT
    attendee_id,
    name,
    COALESCE(email, 'Not Provided') AS email
FROM Attendees;

-- SQLBook: Code
SELECT
    e.event_name,

    COALESCE(
        SUM(
            CASE
                WHEN p.payment_status = 'Success'
                THEN p.amount_paid
                ELSE 0
            END
        ),
        0
    ) AS total_revenue,

    RANK() OVER (
        ORDER BY
        COALESCE(
            SUM(
                CASE
                    WHEN p.payment_status = 'Success'
                    THEN p.amount_paid
                    ELSE 0
                END
            ),
            0
        ) DESC
    ) AS revenue_rank

FROM Events e

LEFT JOIN Tickets t
ON e.event_id = t.event_id

LEFT JOIN Payments p
ON t.ticket_id = p.ticket_id

GROUP BY e.event_id, e.event_name;
-- SQLBook: Code
SELECT
    payment_id,
    payment_date,
    amount_paid,

    SUM(amount_paid) OVER (
        ORDER BY payment_date
    ) AS cumulative_sales

FROM Payments
WHERE payment_status = 'Success';


-- Running total of attendees per event
SELECT
    e.event_name,
    t.ticket_id,
    t.attendee_id,

    COUNT(*) OVER (
        PARTITION BY e.event_id
        ORDER BY t.ticket_id
    ) AS running_attendees

FROM Events e

JOIN Tickets t
ON e.event_id = t.event_id

WHERE t.status = 'Confirmed';
-- SQLBook: Code
SELECT
    event_name,
    total_seats,
    available_seats,

    CASE
        WHEN available_seats < total_seats * 0.20
            THEN 'High Demand'

        WHEN available_seats BETWEEN
             total_seats * 0.20
             AND total_seats * 0.50
            THEN 'Moderate Demand'

        ELSE 'Low Demand'
    END AS demand_category

FROM Events;
-- SQLBook: Code
SELECT
    payment_id,
    payment_status,

    CASE
        WHEN payment_status = 'Success'
            THEN 'Successful'

        WHEN payment_status = 'Failed'
            THEN 'Failed'

        ELSE 'Pending'
    END AS payment_category

FROM Payments;
